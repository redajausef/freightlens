# Copy to .env. Never commit a real key. Demo mode makes no external requests.
FREIGHTLENS_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
NVIDIA_API_KEY=
KIMI_MODEL=moonshotai/kimi-k3
